# MewResources.cmake
# Automatically embeds everything under mewresources/ as PE resources of type "MEWRESOURCE".
# At runtime, call ParaboxAPI::RegisterModResources(hModule) to automatically register all of them.

function(mew_target_resources TARGET_NAME)
    set(options)
    set(oneValueArgs DIRECTORY)
    set(multiValueArgs)
    cmake_parse_arguments(MEW_RES "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(NOT MEW_RES_DIRECTORY)
        set(MEW_RES_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/mewresources")
    endif()

    if(EXISTS "${MEW_RES_DIRECTORY}")
        file(GLOB_RECURSE RES_FILES CONFIGURE_DEPENDS LIST_DIRECTORIES false RELATIVE "${MEW_RES_DIRECTORY}" "${MEW_RES_DIRECTORY}/*")
        list(SORT RES_FILES)

        if(RES_FILES)
            set(GEN_MANIFEST "${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}_resources_manifest.txt")
            set(GEN_RC "${CMAKE_CURRENT_BINARY_DIR}/${TARGET_NAME}_mewresources.rc")

            set(MANIFEST_CONTENT "")
            set(RC_CONTENT "// Auto-generated by mew_target_resources\n")
            string(APPEND RC_CONTENT "1 MEWRESOURCE \"${GEN_MANIFEST}\"\n")

            set(RES_ID 1001)
            foreach(REL_PATH IN LISTS RES_FILES)
                file(TO_CMAKE_PATH "${MEW_RES_DIRECTORY}/${REL_PATH}" FULL_PATH)
                if(IS_DIRECTORY "${FULL_PATH}")
                    continue()
                endif()
                # Use forward slashes in relative virtual path
                string(REPLACE "\\" "/" VIRTUAL_PATH "${REL_PATH}")
                string(APPEND MANIFEST_CONTENT "${RES_ID} ${VIRTUAL_PATH}\n")
                string(APPEND RC_CONTENT "${RES_ID} MEWRESOURCE \"${FULL_PATH}\"\n")
                math(EXPR RES_ID "${RES_ID} + 1")
            endforeach()

            file(WRITE "${GEN_MANIFEST}" "${MANIFEST_CONTENT}")
            file(WRITE "${GEN_RC}" "${RC_CONTENT}")

            set_source_files_properties("${GEN_RC}" PROPERTIES LANGUAGE RC GENERATED TRUE)
            target_sources(${TARGET_NAME} PRIVATE "${GEN_RC}")
            message(STATUS "[MewResources] Configured embedded resources for ${TARGET_NAME} from ${MEW_RES_DIRECTORY}")
        endif()
    endif()
endfunction()
